# ===============================================
# AntojitosBot - Configuración de Entorno
# ===============================================

# Puerto del Servidor Webhook
PORT=3000
NODE_ENV=development

# Proveedor de IA: "openai" | "gemini" | "mock" (para pruebas sin API keys)
AI_PROVIDER=openai

# OpenAI API Key (Requerido si AI_PROVIDER=openai)
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=10000
OPENAI_MAX_RETRIES=2

# Google Gemini API Key (Requerido si AI_PROVIDER=gemini)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# Proveedor de WhatsApp: "simulator" | "cloud_api" | "evolution_api"
WHATSAPP_PROVIDER=simulator

# WhatsApp Cloud API (Opcional, si WHATSAPP_PROVIDER=cloud_api)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App Secret de Meta para validar X-Hub-Signature-256 (obligatorio en cloud_api)
WHATSAPP_APP_SECRET=

# Número de Teléfono del Grupo / Contacto de Cocina
KITCHEN_PHONE_NUMBER=+573001234567

# Persistencia: local (archivos + SQLite) o PostgreSQL administrado
DATABASE_PROVIDER=local
DATABASE_URL=
DATABASE_PATH=./data/antojitos.db
PANEL_API_URL=
PANEL_API_TOKEN=
ENABLE_ORDER_OUTBOX=false
OUTBOX_DISPATCH_INTERVAL_MS=5000

# Evolution API (Opcional, si WHATSAPP_PROVIDER=evolution_api)
EVOLUTION_API_URL=https://tu-evolution-api.example.com
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=antojitos
# Fuentes de Evolution consideradas intervención humana desde la app móvil.
EVOLUTION_HUMAN_SOURCES=android,ios

# Redis administrado con TLS (rediss://). No usar el Redis interno de Evolution.
REDIS_URL=rediss://:password@host:6380
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
# Upstash REST variables are kept for deployment/configuration reference.
# The application uses REDIS_URL for ioredis operations.
UPSTASH_REDIS_REST_URL=https://wondrous-katydid-243562.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Token Bearer para GET /api/orders en producción.
ADMIN_API_TOKEN=
# Teléfonos autorizados para el panel, separados por coma. Requiere token + teléfono.
ADMIN_ALLOWED_PHONES=573001234567
# Silencio por intervención humana. Por defecto son 5 minutos.
COEXISTENCE_COOLDOWN_MINUTES=5
BUSINESS_TIMEZONE=America/Bogota
# Minutos desde medianoche: 780=13:00, 1260=21:00
BUSINESS_OPEN_MINUTE=780
BUSINESS_CLOSE_MINUTE=1260
# ISO weekday: domingo=0, lunes=1 ... sábado=6
BUSINESS_CLOSED_WEEKDAYS=1
BUSINESS_CLOSED_MESSAGE=¡Hola! 🍓 En este momento estamos fuera de horario. Déjanos tu mensaje y te atenderemos en nuestro próximo horario de atención.
