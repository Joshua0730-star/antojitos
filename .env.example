# ==============================================================================
# ANTOJITOS BOT - VARIABLES DE CONFIGURACIÓN DE PRODUCCIÓN
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP (EXPRESS)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. PROVEEDOR DE INTELIGENCIA ARTIFICIAL Y VISIÓN OCR
# Opciones disponibles: "openai" | "gemini" | "mock"
# ------------------------------------------------------------------------------
AI_PROVIDER=openai

# Configuración OpenAI (Requerido si AI_PROVIDER=openai)
# Consíguela en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o

# Configuración Google Gemini (Requerido si AI_PROVIDER=gemini)
# Consíguela en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# ------------------------------------------------------------------------------
# 3. CONECTOR DE WHATSAPP (PRODUCCIÓN)
# Opciones disponibles: "cloud_api" | "evolution_api" | "simulator"
# En producción, usa "cloud_api" para Meta Cloud API Oficial.
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=cloud_api

# Token de acceso permanente generado en Meta Business Suite / System User
# O Token temporal de prueba en: https://developers.facebook.com/
WHATSAPP_TOKEN=tu_whatsapp_access_token_aqui

# Identificador del número de teléfono asignado en Meta WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui

# Token de verificación secreto que tú defines para validar el Webhook en Meta
WHATSAPP_VERIFY_TOKEN=antojitos_webhook_token_secreto_2026

# ------------------------------------------------------------------------------
# 4. CONTACTO DE COCINA / DESPACHO DE PEDIDOS
# Número de WhatsApp (con código de país ej: +573001234567) al que se enviará
# la plantilla oficial de confirmación de pedidos listos para preparar.
# ------------------------------------------------------------------------------
KITCHEN_PHONE_NUMBER=+573001234567

# ------------------------------------------------------------------------------
# 5. BASE DE DATOS Y ALMACENAMIENTO PERSISTENTE
# Ruta al archivo de almacenamiento local
# ------------------------------------------------------------------------------
DATABASE_PATH=./data/antojitos.db
